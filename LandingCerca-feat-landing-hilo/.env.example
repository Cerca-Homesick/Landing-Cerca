# Medición (F2): clave del proyecto de PostHog (Project settings → Project API key).
# Es pública por diseño (va en el navegador). Sin ella, la página no carga PostHog.
VITE_POSTHOG_KEY=
# Servidor de PostHog en la UE (por defecto). No cambiar salvo que el proyecto esté en EE. UU.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Aviso de privacidad (F1): correo de contacto para preguntas y derechos ARCO / RGPD.
VITE_PRIVACY_EMAIL=

# Formulario de Tally (opcional; por defecto el de la lista de espera).
# VITE_TALLY_EMBED_URL=
